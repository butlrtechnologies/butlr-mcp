        { "time": "2026-10-16T04:00:00Z", "value": 0 },
        { "time": "2026-10-20T04:00:00Z", "value": 0 },
        { "time": "2026-10-23T04:00:00Z", "value": 0 },
        { "time": "2026-10-23T16:00:00Z", "value": 0 }
