{
  "description": "Shared conformance cases for where a retired or sensorless space's recorded history ends (contract Addendum 3, E1-E4). The MCP (src/utils/__tests__/history-end.test.ts) and the dashboard (useSensorlessHistory) both run these; keep the copies identical. Rows are reporting v3 daily-max buckets labelled with their END time; a bucket labelled with `now` is today's partial bucket from the current-day composer.",
  "historyEnd": [
    {
      "name": "archived room whose data stopped months before the archive",
      "timezone": "America/Indiana/Indianapolis",
      "now": "2026-10-23T16:00:00Z",
      "declared": { "archivedAt": "2026-10-22T15:00:00Z" },
      "rows": [
        { "time": "2026-05-01T04:00:00Z", "value": 4 },
        { "time": "2026-05-13T04:00:00Z", "value": 2 },
        { "time": "2026-05-14T04:00:00Z", "value": 0 },
        { "time": "2026-05-15T04:00:00Z", "value": 1 }
      ],
      "expected": { "endDay": "2026-05-13", "windowStart": "2026-04-29" }
    },
    {
      "name": "Indy Floor 7: 13 on Oct 19, 0 on Oct 20, 0 on the move day Oct 21, nothing declared",
      "timezone": "America/Indiana/Indianapolis",
      "now": "2026-10-23T16:00:00Z",
      "declared": {},
      "rows": [
        { "time": "2026-10-20T04:00:00Z", "value": 13 },
        { "time": "2026-10-21T04:00:00Z", "value": 0 },
        { "time": "2026-10-22T04:00:00Z", "value": 0 }
      ],
      "expected": { "endDay": "2026-10-20", "windowStart": "2026-04-29" }
